[user]
	name = Josh Reed
	email = jriddy@gmail.com
	signingkey = 9AE14A057D07EBF4

[includeIf "gitdir:aiven*/"]
	path = .gitconfig-aiven
[alias]
	lga = log --graph --decorate --oneline --all
	cm = commit -m
	st = status
	ap = add -p
	co = checkout
	rup = remote update --prune
	ca = commit --amend
	can = commit --amend --no-edit
	ci = commit
	br = branch
	nfm = checkout origin/main -b
	what-push = "git help cherry cherry -v ; git push --all --dry-run ; git push --tags --dry-run"
	lg = log --graph --decorate --oneline
	cob = checkout -b
	pick = cherry-pick
	nft = checkout origin/trunk -b
	lsbr = branch --list --format='%(refname:short)'
	curbr = rev-parse --abbrev-ref HEAD
	files-changed = diff --name-only --diff-filter=MRA
[pull]
	ff = only
[init]
	defaultBranch = main
[credential]
	helper = "!f() { /root/.vscode-server/bin/5c3e652f63e798a5ac2f31ffd0d863669328dc4c/node /tmp/vscode-remote-containers-51fc934d-de6d-404f-97ae-6f9eabe8bf6c.js git-credential-helper $*; }; f"
[push]
	default = current
[commit]
	gpgsign = true
